{
  "name": "docs",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "predev": "pnpm -C .. run docs:sync-version",
    "dev": "astro dev",
    "dev:local": "pnpm run worker:build && pnpm run worker:setup-dev-vars && concurrently -k -n worker,docs \"pnpm run worker:dev\" \"PUBLIC_GEMINI_WORKER_URL=http://localhost:8787 astro dev\"",
    "dev:local:watch": "pnpm run worker:build && pnpm run worker:setup-dev-vars && concurrently -k -n watch,worker,docs \"pnpm run worker:build:watch\" \"pnpm run worker:dev\" \"PUBLIC_GEMINI_WORKER_URL=http://localhost:8787 astro dev\"",
    "worker:dev": "wrangler dev worker/dist/worker.js --local --config worker/wrangler.toml --show-interactive-dev-session=false",
    "worker:build:watch": "cd worker && tsup worker.ts --watch",
    "worker:setup-dev-vars": "node worker/setup-dev-vars.mjs",
    "worker:build-context": "node worker/build-context.mjs",
    "worker:build": "pnpm run worker:build-context && cd worker && tsup worker.ts",
    "worker:setup-secret": "wrangler secret put GEMINI_API_KEY --config worker/wrangler.toml",
    "worker:test": "vitest run worker/",
    "worker:deploy": "pnpm run worker:test && pnpm run worker:build && wrangler deploy --config worker/wrangler.toml",
    "prebuild": "pnpm -C .. run docs:sync-version && pnpm run worker:build-context",
    "build": "astro build",
    "audit-dist": "node scripts/audit-dist.mjs",
    "stage:deploy": "rm -rf .deploy && mkdir .deploy && cp -R dist .deploy/worktree",
    "deploy:smoke": "node scripts/deploy-smoke.mjs",
    "build:legacy": "node scripts/build-legacy-pages.mjs",
    "typecheck": "pnpm run worker:build-context && astro check",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/starlight": "^0.42.8",
    "@base-ui/react": "^1.9.0",
    "@heroicons/react": "^2.2.0",
    "@northguild/gmt": "^1.20.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-store": "^0.11.2",
    "astro": "^7.4.5",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tanstack/react-devtools": "^0.10.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "jsdom": "^26.1.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
