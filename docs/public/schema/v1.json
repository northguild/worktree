{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "defaultSourceBranch": {
      "type": "string",
      "minLength": 1
    },
    "branchPrefix": {
      "type": "object",
      "properties": {
        "feature": {
          "type": "string"
        },
        "bugfix": {
          "type": "string"
        },
        "chore": {
          "type": "string"
        }
      }
    },
    "jira": {
      "type": "object",
      "properties": {
        "branchType": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "when": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": ["string", "number"]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": ["string", "number"]
                                }
                              },
                              "required": ["id"],
                              "additionalProperties": false
                            }
                          ]
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": ["string", "number"]
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": ["string", "number"]
                                  }
                                },
                                "required": ["id"],
                                "additionalProperties": false
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "description": "Field name or id mapped to the value, id object or list of either that must match. Every field must match."
                  },
                  "type": {
                    "type": "string",
                    "enum": ["feature", "bugfix", "chore"]
                  }
                },
                "required": ["when", "type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "otherwise": {
                    "type": "string",
                    "enum": ["feature", "bugfix", "chore"]
                  }
                },
                "required": ["otherwise"],
                "additionalProperties": false
              }
            ]
          },
          "description": "Ordered rules; the first match wins. `- otherwise: <kind>` sets the kind for an issue no rule matched."
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "deployment": {
          "type": "string",
          "enum": ["cloud", "datacenter"],
          "description": "Which Jira the host is: cloud (Jira Cloud) or datacenter (Jira Data Center, or Server). Unset means cloud."
        }
      }
    },
    "github": {
      "type": "object",
      "properties": {
        "branchType": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "when": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": ["string", "number"]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": ["string", "number"]
                                }
                              },
                              "required": ["id"],
                              "additionalProperties": false
                            }
                          ]
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": ["string", "number"]
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": ["string", "number"]
                                  }
                                },
                                "required": ["id"],
                                "additionalProperties": false
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "description": "Field name or id mapped to the value, id object or list of either that must match. Every field must match."
                  },
                  "type": {
                    "type": "string",
                    "enum": ["feature", "bugfix", "chore"]
                  }
                },
                "required": ["when", "type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "otherwise": {
                    "type": "string",
                    "enum": ["feature", "bugfix", "chore"]
                  }
                },
                "required": ["otherwise"],
                "additionalProperties": false
              }
            ]
          },
          "description": "Ordered rules; the first match wins. `- otherwise: <kind>` sets the kind for an issue no rule matched."
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*(?:_[A-Za-z0-9]+)?\\/[A-Za-z0-9._-]+$",
          "description": "The owner/repo that --github reads issues from and --assign assigns in, for example acme/widgets. Only needed when that is not the upstream remote, or origin without one."
        },
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
          "description": "The GitHub host that --github and --assign use, for example ghe.example.com for GitHub Enterprise Server. Unset means github.com. Used only when this clone has a remote on that host."
        }
      }
    },
    "linear": {
      "type": "object",
      "properties": {
        "branchType": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "when": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": ["string", "number"]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": ["string", "number"]
                                }
                              },
                              "required": ["id"],
                              "additionalProperties": false
                            }
                          ]
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": ["string", "number"]
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": ["string", "number"]
                                  }
                                },
                                "required": ["id"],
                                "additionalProperties": false
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "description": "Field name or id mapped to the value, id object or list of either that must match. Every field must match."
                  },
                  "type": {
                    "type": "string",
                    "enum": ["feature", "bugfix", "chore"]
                  }
                },
                "required": ["when", "type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "otherwise": {
                    "type": "string",
                    "enum": ["feature", "bugfix", "chore"]
                  }
                },
                "required": ["otherwise"],
                "additionalProperties": false
              }
            ]
          },
          "description": "Ordered rules; the first match wins. `- otherwise: <kind>` sets the kind for an issue no rule matched."
        }
      }
    },
    "clickup": {
      "type": "object",
      "properties": {
        "branchType": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "when": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": ["string", "number"]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": ["string", "number"]
                                }
                              },
                              "required": ["id"],
                              "additionalProperties": false
                            }
                          ]
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": ["string", "number"]
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": ["string", "number"]
                                  }
                                },
                                "required": ["id"],
                                "additionalProperties": false
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "description": "Field name or id mapped to the value, id object or list of either that must match. Every field must match."
                  },
                  "type": {
                    "type": "string",
                    "enum": ["feature", "bugfix", "chore"]
                  }
                },
                "required": ["when", "type"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "otherwise": {
                    "type": "string",
                    "enum": ["feature", "bugfix", "chore"]
                  }
                },
                "required": ["otherwise"],
                "additionalProperties": false
              }
            ]
          },
          "description": "Ordered rules; the first match wins. `- otherwise: <kind>` sets the kind for an issue no rule matched."
        },
        "workspaceId": {
          "type": ["string", "number"]
        }
      }
    },
    "branchType": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "when": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": ["string", "number"]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": ["string", "number"]
                            }
                          },
                          "required": ["id"],
                          "additionalProperties": false
                        }
                      ]
                    },
                    {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": ["string", "number"]
                          },
                          {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": ["string", "number"]
                              }
                            },
                            "required": ["id"],
                            "additionalProperties": false
                          }
                        ]
                      }
                    }
                  ]
                },
                "description": "Field name or id mapped to the value, id object or list of either that must match. Every field must match."
              },
              "type": {
                "type": "string",
                "enum": ["feature", "bugfix", "chore"]
              }
            },
            "required": ["when", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "otherwise": {
                "type": "string",
                "enum": ["feature", "bugfix", "chore"]
              }
            },
            "required": ["otherwise"],
            "additionalProperties": false
          }
        ]
      },
      "description": "Ordered rules; the first match wins. `- otherwise: <kind>` sets the kind for an issue no rule matched."
    },
    "branchName": {
      "type": "string"
    },
    "copy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postCreate": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "title": ".worktree.yml",
  "description": "Team configuration for @northguild/worktree, read from the repository's default branch.",
  "$id": "https://northguild.github.io/worktree/schema/v1.json"
}
