---
/**
 * The Dox crystal, Astro side (plan #309 D5; ported from gmt's DoxMark.astro). It is drawn on every page, in the header's
 * and the mobile menu's "Chat with Dox" link and in the landing's "Ask Dox", where the chat's stylesheet is not loaded:
 * which is why its presentation (`.gmt-dox-mark`) is in custom.css and not in dox-hive.css. The geometry is shared with
 * the React copy (chat/components/hive/HiveGlyph.tsx) through `lib/dox-mark`, so the two cannot drift.
 *
 * `aria-hidden`: every consumer supplies its own accessible name (the header link is "Chat with Dox"), so the mark must
 * not announce twice. Its colour is `currentColor`, so it takes the link's.
 */
import {
  MARK_INNER,
  MARK_OUTER,
  MARK_SHEEN,
  MARK_SPOKES,
  MARK_VIEWBOX,
} from "../lib/dox-mark";

interface Props {
  /** Gradient ids are unique per document: two marks on a page sharing one would make the second reuse the first's stops. */
  id?: string;
}

const { id = "header" } = Astro.props;
const faceId = `gmt-dox-face-${id}`;
const sheenId = `gmt-dox-sheen-${id}`;
---

<svg class="gmt-dox-mark" viewBox={MARK_VIEWBOX} focusable="false" aria-hidden="true">
  <defs>
    <linearGradient id={faceId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="currentColor" stop-opacity="0.55" />
      <stop offset="55%" stop-color="currentColor" stop-opacity="0.16" />
      <stop offset="100%" stop-color="currentColor" stop-opacity="0.4" />
    </linearGradient>
    <linearGradient id={sheenId} x1="0" y1="0" x2="0.6" y2="1">
      <stop offset="0%" stop-color="var(--gmt-ice)" stop-opacity="0.75" />
      <stop offset="45%" stop-color="var(--gmt-ice)" stop-opacity="0.05" />
      <stop offset="100%" stop-color="var(--gmt-ice)" stop-opacity="0" />
    </linearGradient>
  </defs>

  <polygon points={MARK_OUTER} fill={`url(#${faceId})`} />
  <polygon points={MARK_OUTER} class="gmt-dox-mark-edge" />

  <g class="gmt-dox-mark-facet">
    {MARK_SPOKES.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
  </g>

  <polygon points={MARK_INNER} class="gmt-dox-mark-table" />
  <polygon points={MARK_SHEEN} fill={`url(#${sheenId})`} />
</svg>
