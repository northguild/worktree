---
/**
 * Starlight's Head plus two things it does not do: a `<title>` that never repeats the site title (D9), and the page's
 * JSON-LD (D10). Starlight already emits the canonical link, `og:title`, `og:description`, `og:url`, `og:site_name`,
 * `og:type`, `og:locale`, `twitter:card` and the meta description (plan §9 Q8, read off the built HTML), so none of
 * those are repeated here.
 *
 * It also points every page but the 404 at its llms.txt with `rel="describedby"` (D8); the URL is the one llms-txt.ts
 * renders to, not a third copy of it.
 *
 * The share preview (`og:image`, `twitter:image` and their alt text) and the icon links are site-wide, so they are
 * `starlight({ head })` entries in astro.config.mjs rather than anything here (plan §9 Q3).
 */
import { LLMS_TXT_URL } from "../lib/llms-txt";
import { cliVersion } from "../lib/site-meta";
import { buildStructuredData, headTitle } from "../lib/structured-data";

const { head, entry, siteTitle } = Astro.locals.starlightRoute;

// "·" is astro.config.mjs's titleDelimiter (GMT's middle dot); the audit fails any title that still carries " | ".
// The 404 (404.md) is in the collection but is not a page of the site: no canonical, no og:url and no JSON-LD may name
// /worktree/404/, which answers 404. The audit checks the built 404.html for each.
const isNotFound = entry.id === "404";
const namesThisUrl = ({ tag, attrs }: (typeof head)[number]) =>
  (tag === "link" && attrs?.rel === "canonical") ||
  (tag === "meta" && attrs?.property === "og:url");

const tags = head
  .filter((tag) => !(isNotFound && namesThisUrl(tag)))
  .map((tag) =>
    tag.tag === "title"
      ? { ...tag, content: headTitle(entry.data.title, siteTitle, "·") }
      : tag,
  );

// Path relative to the site root: "" for the landing, "getting-started" or "commands/branch" for a nested page.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.slice(base.length).replace(/^\/|\/$/g, "");
const structuredData = JSON.stringify(
  buildStructuredData({ path, title: entry.data.title }, cliVersion),
);
---

{tags.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
{!isNotFound && <link rel="describedby" type="text/plain" href={LLMS_TXT_URL} />}
{!isNotFound && <script type="application/ld+json" set:html={structuredData} />}
