---
/**
 * Starlight's mobile menu footer, with the "Chat with Dox" link before the social icons (plan #309 D2; ported from gmt's
 * MobileMenuFooter.astro). Below `md` the header's right group is hidden, so the link would be unreachable there. Same
 * link, label and current-page state as the header's (Header.astro). Structure copied from @astrojs/starlight 0.42.8,
 * dist/components/MobileMenuFooter.astro. The chip look is the shared `.header-chip` in custom.css; the menu is on the
 * pages with a sidebar (not the landing, the 404 or /dox).
 */
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import DoxMark from "./DoxMark.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const onDox = Astro.url.pathname.replace(/\/$/, "") === `${base}/dox`;
---

<div class="mobile-preferences sl-flex">
  <div class="social-icons">
    <a
      href={`${base}/dox/`}
      class="header-chip dox-link"
      aria-label="Chat with Dox"
      title="Chat with Dox"
      aria-current={onDox ? "page" : undefined}
    >
      <DoxMark id="menu" />
    </a>
    <SocialIcons />
  </div>
  <ThemeSelect />
  <LanguageSelect />
</div>

<style>
  @layer starlight.core {
    .social-icons {
      display: flex;
      margin-inline-end: auto;
      gap: 1rem;
      align-items: center;
      padding-block: 1rem;
    }
    .social-icons:empty {
      display: none;
    }
    .mobile-preferences {
      justify-content: space-between;
      flex-wrap: wrap;
      border-top: 1px solid var(--sl-color-gray-6);
      column-gap: 1rem;
      padding: 0.5rem 0;
    }
  }
</style>
