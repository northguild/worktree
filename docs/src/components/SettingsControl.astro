---
/**
 * The header's settings control (plan #352, D1-D3): one gear button, last in the right group after Dox, GitHub and
 * Discord, that opens a popover holding the reader's settings. In this phase that is the "Dark theme" switch alone;
 * later phases add the sound controls. One copy, in the header: the mobile menu has none (the right group is hidden
 * below `md`, and the plan keeps the menu as it is).
 *
 * The gear is GMT's exactly: the `GEAR` SVG below is copied from gmt apps/dox/src/components/settings-control.ts at
 * commit d6031ecd (Lucide `settings`, ISC, filled so it reads as solid as GitHub's and Discord's marks beside it, at the
 * icon buttons' 20 px; the view box is cropped to the gear so it stands as tall as GitHub's mark; the hub is a second
 * subpath, so the even-odd rule cuts it out of the fill). The button is a native `<button popovertarget>` named
 * "Settings" and the panel a native `[popover]`: Escape, an outside press and the return of focus to the gear are the
 * browser's. The panel is in the top layer, anchored under the gear, so opening it moves nothing in the bar.
 *
 * The switch is a native `<input type="checkbox" role="switch">` (the APG Switch pattern) named by its label,
 * "Dark theme"; the pill and its leaf are the sibling SVG, drawn by settings-control.css, and the input sits over it,
 * invisible, so the control is the browser's own. `src/lib/settings-control.ts` wires it; the theme rule is
 * `src/lib/theme.ts`.
 */
import "./settings-control.css";

const GEAR = `<svg viewBox="1 1 22 22" width="20" height="20" fill="currentColor" fill-rule="evenodd" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915ZM15 12a3 3 0 1 0-6 0 3 3 0 0 0 6 0Z"/></svg>`;
---

<div class="settings-control print:hidden" data-settings-control>
  <button
    type="button"
    id="settings-button"
    class="header-chip settings-toggle"
    popovertarget="settings-pop"
    aria-label="Settings"
    title="Settings"
    aria-expanded="false"
  >
    <Fragment set:html={GEAR} />
  </button>
  <div id="settings-pop" class="settings-pop" popover role="group" aria-label="Settings">
    <label class="settings-row">
      <span class="settings-row-label">Dark theme</span>
      <span class="leaf-switch">
        <input type="checkbox" role="switch" id="settings-theme-dark" checked />
        <svg viewBox="0 0 46 26" aria-hidden="true" focusable="false">
          <rect class="leaf-switch-track" x="1" y="1" width="44" height="24" rx="12"></rect>
          <g class="leaf-switch-leaf">
            <path class="leaf-switch-blade" d="M6 18 C 6 10, 11 6, 20 6 C 20 14, 15 19, 6 18 Z"></path>
            <path class="leaf-switch-midrib" d="M7 17 L 17 9"></path>
          </g>
        </svg>
      </span>
    </label>
  </div>
</div>

<script>
  import { mountSettingsControl } from "../lib/settings-control";
  mountSettingsControl();
</script>
