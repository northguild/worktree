---
/**
 * Starlight's ThemeSelect, replaced by a two-state toggle (plan #266, D1): one button showing the current theme's icon.
 * A click always shows the opposite of the theme on screen, and saves it only while it differs from the system's
 * (plan #352, D4).
 * Starlight renders this component in the header and again in the mobile menu, so the button is in both.
 *
 * Ported from GMT, apps/dox/src/components/ThemeSelect.astro at commit b15b3899. The rule (what a click shows and
 * saves) is in src/lib/theme.ts, where it is tested; the icon is drawn by
 * ThemeProvider.astro's `updatePickers()`. The chip look is the shared `.header-chip` in custom.css.
 */
---

<starlight-theme-select>
  <button
    type="button"
    class="theme-toggle header-chip"
    aria-label="Toggle color theme"
  >
    <svg
      class="theme-icon"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    ></svg>
  </button>
</starlight-theme-select>

{/* Inlined to avoid FOUC. Uses global scope from `ThemeProvider.astro`. */}
<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  import { readTheme, type Theme, writeTheme } from "../lib/theme";

  declare const StarlightThemeProvider: {
    updatePickers(): void;
  };

  const opposite = (theme: Theme): Theme => (theme === "light" ? "dark" : "light");

  function applyTheme() {
    document.documentElement.dataset.theme = readTheme();
    StarlightThemeProvider.updatePickers();
  }

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      this.querySelector("button.theme-toggle")?.addEventListener("click", () => {
        // The opposite of the theme on screen, not of storage: another tab may have saved one, or storage may throw.
        writeTheme(opposite(document.documentElement.dataset.theme === "dark" ? "dark" : "light"));
        StarlightThemeProvider.updatePickers();
      });

      // A change of the system preference re-applies the theme; `readTheme` keeps a saved theme, so it moves the page
      // only while nothing is saved.
      window.matchMedia("(prefers-color-scheme: light)").addEventListener("change", applyTheme);

      applyTheme();
    }
  }

  customElements.define("starlight-theme-select", StarlightThemeSelect);
</script>
