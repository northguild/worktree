{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["vitest/globals"]
  },
  "include": [
    ".astro/types.d.ts",
    "src",
    "worker",
    "test-setup.ts",
    "vitest.config.ts",
