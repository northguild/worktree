{
  "name": "@northguild/worktree",
  "version": "2.1.2",
  "description": "A CLI tool for managing git worktrees with enhanced workflow features",
  "main": "./bin/run.js",
  "type": "module",
  "scripts": {
    "build": "shx rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "verify": "pnpm check && pnpm typecheck && pnpm test",
    "changeset:add": "changeset add",
    "changeset:status": "changeset status --since=origin/main",
    "changeset:prepare-release": "changeset version && pnpm sync-version",
    "sync-version": "pnpm docs:sync-version",
    "prepublishOnly": "pnpm build && pnpm test",
    "docs:sync-version": "node ./scripts/sync-docs-version.mjs && biome format ./docs/src/lib/site-meta.ts --write",
    "docs:test": "pnpm --filter docs test",
    "docs:dev": "pnpm docs:sync-version && pnpm --filter docs run dev",
    "docs:dev-local": "pnpm docs:sync-version && pnpm --filter docs run dev:local:watch",
    "docs:build": "pnpm docs:sync-version && pnpm --filter docs build"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "skills"
  ],
  "keywords": [
    "git",
    "worktree",
    "cli",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/northguild/worktree.git"
  },
  "contributors": [
    {
      "name": "Baldur Páll Hólmgeirsson",
      "url": "https://github.com/baldurpan"
    },
    {
      "name": "Craig O. Curtis",
      "url": "https://github.com/craig-o-curtis"
    }
  ],
  "homepage": "https://github.com/northguild/worktree",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=23.5.0 || ^22.13.0 || ^20.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "bin": {
    "worktree": "bin/run.js",
    "@northguild/worktree": "bin/run.js"
  },
  "oclif": {
    "bin": "worktree",
    "aliases": [
      "@northguild/worktree"
    ],
    "plugins": [
      "@oclif/plugin-*"
    ],
    "commands": "./dist/commands",
    "dirname": "worktree",
    "topicSeparator": " ",
    "warn-if-update-available": {
      "timeoutInDays": 7,
      "message": "<%= config.name %> update available from <%= chalk.greenBright(config.version) %> to <%= chalk.greenBright(latest) %>.",
      "registry": "https://registry.npmjs.org/"
    }
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "@oclif/core": "^4.14.0",
    "@oclif/plugin-help": "^6.3.0",
    "@oclif/plugin-not-found": "^3.3.0",
    "@oclif/plugin-warn-if-update-available": "^3.2.0",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@changesets/cli": "^3.0.3",
    "@northguild/gmt-biome": "^1.1.1",
    "@oclif/test": "^4.2.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^18.19.130",
    "semver": "^7.8.5",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
